# Copy to .env (root, used by docker compose) and web/.env.local (local dev).

# Database
DATABASE_URL=postgresql://chartsense:chartsense@localhost:5432/chartsense

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used in email links (falls back to the request host)
APP_URL=http://localhost:3000

# Email: set ONE of these (dev without either prints emails to the server console)
RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465
EMAIL_FROM="ChartSense <no-reply@example.com>"

# S3-compatible storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
# Address the BROWSER uses for presigned uploads (defaults to S3_ENDPOINT). In docker compose the
# web container talks to http://minio:9000, but browsers need http://localhost:9000.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chartsense
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Without the S3 settings above, dev uses a local-disk store (web/.storage). Force one with
# STORAGE_DRIVER=s3 | local (production requires S3 unless STORAGE_DRIVER=local is explicit).
# STORAGE_DRIVER=

# Background jobs. Run the worker with `npm run worker` (docker compose starts it as `worker`).
# Dev without Redis: uploads are processed inside the Next.js server when ANALYSIS_SERVICE_URL is set.
REDIS_URL=redis://localhost:6379
# Datasets processed in parallel per worker process
WORKER_CONCURRENCY=2

# Analysis microservice — token must match on both sides (openssl rand -hex 32)
ANALYSIS_SERVICE_URL=http://localhost:8000
ANALYSIS_SERVICE_TOKEN=

# AI (server-side only — never expose to the browser)
ANTHROPIC_API_KEY=

# Upload limit in megabytes
MAX_UPLOAD_MB=50
